data/
*.pyc
__pycache__/
.venv/
*.egg-info/
.pytest_cache/
# results/ is tracked deliberately: the JSONs are small and shipping them is what
# makes "every table and figure regenerates" checkable in seconds instead of
# requiring a 20.8 GB download and a full re-run. Large or transient outputs stay out.
results/**/*.png
results/**/*.csv
.DS_Store
figures/*.png
!figures/.gitkeep
.coverage
coverage.xml
htmlcov/
pumpwatch_handoff.zip
data/paderborn/

# Synthetic outputs are not tracked. The generator stays - it is the fixture the test
# suite exercises and what `make experiment` runs - but nothing it produces reaches the
# published artifact, so no reader can mistake a simulation for a measurement.
results/results_full.json
figures/synthetic/
